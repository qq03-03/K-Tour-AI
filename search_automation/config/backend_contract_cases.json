{
  "schema_version": "1.0",
  "description": "백엔드 URL 수신 후 실행하는 검색 API 계약 검사입니다. 실행 시 OpenAI 비용이 발생할 수 있습니다.",
  "cases": [
    {
      "case_id": "EXPLICIT_FILTER_OVERRIDE",
      "label": "자연어 부산보다 UI 서울 필터 우선",
      "request": {
        "query": "부산 촬영지",
        "lang": "ko",
        "region": ["서울특별시"],
        "top_k": 5,
        "candidate_k": 50
      },
      "expected": {
        "applied_filters": {"region": ["서울특별시"]},
        "all_results": {"region": ["서울특별시"]},
        "result_count": {"min": 1, "max": 5},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "SAME_FIELD_OR",
      "label": "같은 필드 place_id OR",
      "request": {
        "query": "궁궐 촬영지",
        "lang": "ko",
        "place_id": ["P016", "P017"],
        "top_k": 20,
        "candidate_k": 100
      },
      "expected": {
        "applied_filters": {"place_id": ["P016", "P017"]},
        "all_results": {"place_id": ["P016", "P017"]},
        "contains_source_segment_ids": ["V011_P016_S001", "V011_P017_S001"],
        "result_count": {"min": 2, "max": 20},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "DIFFERENT_FIELDS_AND",
      "label": "서로 다른 필드 AND",
      "request": {
        "query": "궁궐",
        "lang": "ko",
        "place_id": ["P016"],
        "region": ["서울특별시"],
        "top_k": 10,
        "candidate_k": 50
      },
      "expected": {
        "applied_filters": {"place_id": ["P016"], "region": ["서울특별시"]},
        "all_results": {"place_id": ["P016"], "region": ["서울특별시"]},
        "result_count": {"min": 1, "max": 10},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "NO_FILTER_RELAXATION",
      "label": "모순된 명시 필터는 0건 유지",
      "request": {
        "query": "궁궐",
        "lang": "ko",
        "place_id": ["P016"],
        "region": ["부산광역시"],
        "top_k": 5,
        "candidate_k": 50
      },
      "expected": {
        "applied_filters": {"place_id": ["P016"], "region": ["부산광역시"]},
        "result_count": {"exact": 0},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "THEME_ONLY_FLOWER",
      "label": "꽃 테마 버튼 검색",
      "request": {
        "query": "",
        "lang": "ko",
        "theme": ["flower"],
        "top_k": 20,
        "candidate_k": 100
      },
      "expected": {
        "applied_filters": {"theme": ["flower"]},
        "contains_source_segment_ids": ["V001_P003_S001"],
        "all_source_segment_ids_in": [
          "V001_P001_S001", "V001_P002_S001", "V001_P003_S001",
          "V002_P004_S001", "V002_P004_S002", "V002_P004_S003",
          "V013_P020_S001", "V015_P087_S001", "V032_P056_S001",
          "V033_P057_S001", "V042_P062_S001", "V044_P067_S001",
          "V044_P067_S002", "V045_P069_S001", "V045_P070_S001",
          "V046_P072_S001", "V046_P072_S002", "V056_P004_S001",
          "V062_P083_S001"
        ],
        "result_count": {"min": 1, "max": 20},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "REGION_GROUP_GYEONGSANG",
      "label": "경상도 광역권 확장",
      "request": {
        "query": "경상도 촬영지",
        "lang": "ko",
        "region": ["경상도"],
        "top_k": 20,
        "candidate_k": 100
      },
      "expected": {
        "applied_filters": {"region": ["부산광역시", "대구광역시", "울산광역시", "경상북도", "경상남도"]},
        "all_results": {"region": ["부산광역시", "대구광역시", "울산광역시", "경상북도", "경상남도"]},
        "minimum_distinct_result_values": {"region": 2},
        "result_count": {"min": 1, "max": 20},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "REGION_EXACT_BUSAN",
      "label": "부산은 부산만",
      "request": {
        "query": "부산 촬영지",
        "lang": "ko",
        "region": ["부산광역시"],
        "top_k": 10,
        "candidate_k": 50
      },
      "expected": {
        "applied_filters": {"region": ["부산광역시"]},
        "all_results": {"region": ["부산광역시"]},
        "result_count": {"min": 1, "max": 10},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "JEJU_SEOGWIPO_AND",
      "label": "제주 지역과 서귀포 city AND",
      "request": {
        "query": "제주 서귀포 촬영지",
        "lang": "ko",
        "region": ["제주특별자치도"],
        "city": ["서귀포시"],
        "top_k": 10,
        "candidate_k": 50
      },
      "expected": {
        "applied_filters": {"region": ["제주특별자치도"], "city": ["서귀포시"]},
        "all_results": {"region": ["제주특별자치도"], "city": ["서귀포시"]},
        "result_count": {"min": 1, "max": 10},
        "no_filter_relaxation": true
      }
    },
    {
      "case_id": "SEASONAL_TITLE_PROTECTION",
      "label": "겨울연가를 겨울 필터로 오인하지 않음",
      "request": {
        "query": "겨울연가 촬영지",
        "lang": "ko",
        "top_k": 5,
        "candidate_k": 50
      },
      "expected": {
        "applied_filters": {"drama_title": ["겨울연가"]},
        "forbidden_filter_fields": ["season"],
        "all_results": {"drama_title": ["겨울연가"]},
        "result_count": {"min": 1, "max": 5}
      }
    },
    {
      "case_id": "FULL_RESULT_CONTRACT",
      "label": "Top-K·중복 제거·rank·null·RRF 전체 계약",
      "request": {
        "query": "드라마 촬영지 여행지를 추천해줘",
        "lang": "ko",
        "top_k": 50,
        "candidate_k": 250
      },
      "expected": {
        "result_count": {"min": 1, "max": 50},
        "unique_source_segment_id": true,
        "strict_result_contract": true
      }
    }
  ]
}
